rules_version = '2';

// Multi-School Management System — Firestore Security Rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Global User Profiles ──────────────────────────────────────────────────
    // Maps Firebase Auth UID -> User Profile with role and schoolId
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // ── School Root & Subcollections ──────────────────────────────────────────
    // Allows authenticated users to read and write school data
    match /schools/{schoolId} {
      allow read, write: if request.auth != null;

      // Allow public creation of admission enquiries & teacher applications inside school
      match /admissionEnquiries/{document=**} {
        allow create: if true;
        allow read, update, delete: if request.auth != null;
      }

      match /teacherApplications/{document=**} {
        allow create: if true;
        allow read, update, delete: if request.auth != null;
      }

      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Public Admission Enquiries & Teacher Applications (Top-Level) ─────────
    match /admissionEnquiries/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /teacherApplications/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ── School Directory (Public lookup for teacher onboarding & system security) ────────
    match /schoolDirectory/{document=**} {
      allow read, write: if true;
    }

    // ── System Configuration & Subscription Master Control ──────────────────
    match /system_config/{document=**} {
      allow read, write: if true;
    }

    // ── License Keys Master Control ───────────────────────────────────────────
    match /licenseKeys/{document=**} {
      allow read, write: if true;
    }

    // ── User Feedbacks & Star Ratings ─────────────────────────────────────────
    match /feedbacks/{document=**} {
      allow read, write: if true;
    }
  }
}
